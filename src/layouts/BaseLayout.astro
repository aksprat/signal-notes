---
import '../styles/global.css';
import { profile } from '../data';
const { title = 'Signal Notes', description = 'Candid field notes from the world of AI.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Signal Notes home"><span class="brand-mark">∿</span> SIGNAL NOTES</a>
      <nav aria-label="Main navigation">
        <a href="/articles">Read</a>
        <a href="/videos">Watch</a>
        <a href="/builds">Builds</a>
        <a href="/#start-here">Start here</a>
      </nav>
      <a class="header-link" href={profile.channelUrl} target="_blank" rel="noreferrer">YouTube ↗</a>
    </header>
    <main><slot /></main>
    <footer>
      <span class="brand"><span class="brand-mark">∿</span> SIGNAL NOTES</span>
      <p>Making sense of AI, one useful idea at a time.</p>
      <a href={`mailto:${profile.email}`}>Say hello ↗</a>
    </footer>
  </body>
</html>
