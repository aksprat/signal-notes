---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLibrary from '../../components/ArticleLibrary.astro';
import { articles } from '../../data';
import { getCollection } from 'astro:content';
const notes = (await getCollection('articles')).map(entry => ({ ...entry.data, slug: entry.id, searchText: entry.body }));
---
<BaseLayout title="The notebook — AIFieldNotes">
  <section class="listing-hero wrap"><p class="eyebrow">THE NOTEBOOK / {notes.length + articles.length} ARTICLES & FIELD GUIDES</p><h1>Follow your <em>curiosity.</em></h1><p>Clear mental models, practical guides, and lessons from the field. Search for an idea, explore a topic, or find something unexpected.</p></section>
  <section class="section wrap library-section"><ArticleLibrary items={[...notes, ...articles]} /></section>
</BaseLayout>
