---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const { Content } = await render(article);
---
<BaseLayout title={`${article.data.title} — Signal Notes`} description={article.data.summary}>
  <article class="article-page">
    <a class="back-link" href="/articles">← All articles</a>
    <p class="eyebrow">{article.data.topics.join(' / ')} · {article.data.readTime}</p>
    <h1>{article.data.title}</h1>
    <p class="article-summary">{article.data.summary}</p>
    <div class="article-rule"></div>
    <div class="article-body"><Content /></div>
  </article>
</BaseLayout>
