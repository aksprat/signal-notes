---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { profile } from '../../data';
export async function getStaticPaths() {
  return (await getCollection('articles')).map(article => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const { Content, headings } = await render(article);
const related = (await getCollection('articles')).filter(entry => entry.id !== article.id).sort((first, second) => second.data.topics.filter(topic => article.data.topics.includes(topic)).length - first.data.topics.filter(topic => article.data.topics.includes(topic)).length).slice(0, 3);
---
<BaseLayout title={`${article.data.title} — AIFieldNotes`} description={article.data.summary}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article class="reading-layout wrap">
    <header class="article-header"><a class="back-link" href="/articles">← Back to the notebook</a><p class="eyebrow">{article.data.date} <span> / </span> {article.data.readTime}</p><h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p><div class="article-byline"><span class="avatar">AP</span><span><strong>{profile.name}</strong><small>AI & cloud infrastructure</small></span><button class="share-button" type="button" hidden>Copy link ↗</button><span class="sr-only" role="status" data-share-status></span></div><div class="tags">{article.data.topics.map(topic => <span>{topic}</span>)}</div></header>
    <aside class="article-sidebar"><p class="eyebrow">IN THIS NOTE</p><nav aria-label="Table of contents">{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav><div class="sidebar-note"><span aria-hidden="true">✳</span><p>One idea at a time.<br />That’s how it clicks.</p><a class="text-link" href="/articles">Explore more notes ↗</a></div></aside>
    <div class="article-body"><Content /><div class="article-end"><span aria-hidden="true">✳</span><p>A little less noise. A little more understanding.</p><a class="text-link" href="/articles">Back to all notes ↗</a></div></div>
  </article>
  <section class="section wrap related-section"><div class="section-header"><div><p class="eyebrow">KEEP PULLING THE THREAD</p><h2>Connect <em>the dots.</em></h2></div></div><div class="card-grid cols-3">{related.map(entry => <ContentCard item={{ ...entry.data, slug: entry.id }} artwork={false} />)}</div></section>
  <script>
    const progress = document.querySelector<HTMLElement>('.reading-progress span');
    const body = document.querySelector<HTMLElement>('.article-body');
    let scheduled = false;
    function updateProgress() {
      if (body && progress) {
        const end = body.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
        progress.style.transform = `scaleX(${Math.min(1, Math.max(0, window.scrollY / Math.max(1, end)))})`;
      }
      scheduled = false;
    }
    window.addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updateProgress); } }, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
    const share = document.querySelector<HTMLButtonElement>('.share-button');
    if (share && navigator.clipboard) {
      share.hidden = false;
      share.addEventListener('click', async () => {
        const status = document.querySelector<HTMLElement>('[data-share-status]')!;
        try { await navigator.clipboard.writeText(window.location.href); share.textContent = 'Link copied ✓'; status.textContent = 'Article link copied to clipboard.'; }
        catch { status.textContent = 'Could not copy. Copy the URL from your address bar instead.'; }
      });
    }
  </script>
</BaseLayout>
