---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ContentCard from '../../components/ContentCard.astro'; import { videos, profile } from '../../data';
---
<BaseLayout title="Videos — Signal Notes"><section class="listing-hero"><p class="eyebrow">Watch</p><h1>AI, in<br /><em>motion.</em></h1><p>Visual walkthroughs for ideas that are easier to understand when you can see them unfold.</p><p><a class="text-link" href={profile.channelUrl} target="_blank" rel="noreferrer">Visit my YouTube channel ↗</a></p></section><section class="latest-section listing"><div class="card-grid">{videos.map(item => <ContentCard item={item} kind="videos" />)}</div></section></BaseLayout>
