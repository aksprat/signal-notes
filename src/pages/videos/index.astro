---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { videos, profile } from '../../data';
---
<BaseLayout title="Videos — Signal Notes">
  <section class="listing-hero">
    <p class="eyebrow">Watch</p>
    <h1>AI, in<br /><em>motion.</em></h1>
    <p>Visual walkthroughs for ideas that are easier to understand when you can see them unfold.</p>
    <p style="margin-top:16px"><a class="text-link" href={profile.channelUrl} target="_blank" rel="noreferrer">Visit my YouTube channel ↗</a></p>
  </section>

  <section class="section">
    <div class="video-grid">
      {videos.map(v => (
        <div class="video-card">
          <span class="play-btn">▶</span>
          <div class="card-meta"><span>{v.topics[0]}</span></div>
          <h3>{v.title}</h3>
          <a href={v.url} target="_blank" rel="noreferrer">Watch on YouTube ↗</a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
