---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { videos, profile } from '../../data';
---
<BaseLayout title="Watch & learn — AIFieldNotes">
  <section class="listing-hero wrap"><p class="eyebrow">THE SCREENING ROOM / {videos.length} WALKTHROUGHS</p><h1>See the idea <em>in action.</em></h1><p>From serverless inference to cloud observability. Practical walkthroughs for things that make more sense when you see them.</p><a class="btn" href={profile.channelUrl} target="_blank" rel="noreferrer">Visit CuriousEnuf on YouTube ↗</a></section>
  <section class="section wrap"><h2 class="sr-only">Video walkthroughs</h2><div class="card-grid cols-3">{videos.map(item => <ContentCard item={item} />)}</div></section>
</BaseLayout>
