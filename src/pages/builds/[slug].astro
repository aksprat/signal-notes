---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { builds } from '../../data';
export function getStaticPaths() { return builds.map(build => ({ params: { slug: build.slug }, props: { build } })); }
const { build } = Astro.props;
---
<BaseLayout title={`${build.title} — AIFieldNotes`} description={build.summary}>
  <article class="article-page">
    <a class="back-link" href="/builds">← All builds</a>
    <p class="eyebrow">{build.status} · {build.date}</p>
    <h1>{build.title}</h1>
    <p class="article-summary">{build.summary}</p>
    <div class="article-rule"></div>
    <div class="article-body"><div class="workbench-note"><strong>On the workbench</strong><p>This experiment is still taking shape. Implementation details and build notes haven’t been published yet.</p></div><p>In the meantime, explore the ideas behind the work.</p><a class="btn" href={build.slug === 'personal-knowledge-lab' ? '/articles/rag' : '/articles/fine-tuning-vs-prompting'}>Read the related field note ↗</a></div>
  </article>
</BaseLayout>
