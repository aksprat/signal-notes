---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { videos, builds, paths, profile } from '../data';
import { getCollection } from 'astro:content';
const learningArticles = (await getCollection('articles')).map(entry => ({ ...entry.data, slug: entry.id }));
const featured = learningArticles.find(a => a.featured) || learningArticles[0];
const latestTwo = learningArticles.filter(a => a.slug !== featured.slug).slice(0, 2);
---
<BaseLayout>

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow"><span class="pulse"></span>AIFieldNotes · by Akshit Pratiush</p>
      <h1>From the<br /><em>AI frontier.</em></h1>
      <div class="hero-row">
        <p>Candid field notes, experiments, and practical guides from the frontlines of AI infrastructure, LLMs, and enterprise AI delivery.</p>
        <a class="btn" href="#start-here">Find your starting point <span class="arrow">↓</span></a>
      </div>
    </div>
  </section>

  <!-- ── Featured article ──────────────────────────────── -->
  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow blue">Featured</p>
        <h2>Start with this one.</h2>
      </div>
      <a class="see-all" href="/articles">All articles →</a>
    </div>
    <div class="featured-card">
      <div>
        <p class="eyebrow" style="margin-bottom:14px">{featured.topics.join(' · ')}</p>
        <h2><a href={`/articles/${featured.slug}`}>{featured.title}</a></h2>
        <p>{featured.summary}</p>
        <div class="tags">{featured.topics.map((t: string) => <span>{t}</span>)}</div>
      </div>
      <div class="featured-right">
        <p style="color:var(--muted);font:11px var(--mono);text-transform:uppercase;letter-spacing:.1em">Why read this?</p>
        <p style="font-size:15px;color:var(--ink-soft)">A solid foundation for understanding what AI systems actually do — and what they can't.</p>
        <a class="btn" href={`/articles/${featured.slug}`} style="align-self:flex-start">Read article →</a>
      </div>
    </div>
  </section>

  <!-- ── Latest notes ──────────────────────────────────── -->
  <section class="section alt">
    <div class="section-header">
      <div>
        <p class="eyebrow">Fresh from the notebook</p>
        <h2>Latest notes</h2>
      </div>
      <a class="see-all" href="/articles">All articles →</a>
    </div>
    <div class="card-grid cols-2">
      {latestTwo.map(item => <ContentCard item={item} />)}
    </div>
  </section>

  <!-- ── Videos ────────────────────────────────────────── -->
  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Watch &amp; learn</p>
        <h2>Ideas that move.</h2>
      </div>
      <a class="see-all" href="/videos">All videos →</a>
    </div>
    <div class="video-grid">
      {videos.slice(0, 3).map(v => (
        <div class="video-card">
          <span class="play-btn">▶</span>
          <div class="card-meta"><span>{v.topics[0]}</span></div>
          <h3>{v.title}</h3>
          <a href={v.url} target="_blank" rel="noreferrer">Watch on YouTube ↗</a>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Builds ─────────────────────────────────────────── -->
  <section class="section alt">
    <div class="section-header">
      <div>
        <p class="eyebrow">Things I'm trying</p>
        <h2>In the lab</h2>
      </div>
      <a class="see-all" href="/builds">All builds →</a>
    </div>
    <div class="card-grid cols-2">
      {builds.map(item => <ContentCard item={item} kind="builds" />)}
    </div>
  </section>

  <!-- ── Start here ────────────────────────────────────── -->
  <section class="section" id="start-here">
    <div class="section-header">
      <div>
        <p class="eyebrow">New around here?</p>
        <h2>Start where you are.</h2>
      </div>
    </div>
    <div class="path-list">
      {paths.map(([number, title, copy, tag]) => (
        <a class="path-item" href="/articles">
          <span class="path-num">{number}</span>
          <div>
            <h3>{title}</h3>
            <p>{copy}</p>
          </div>
          <span class="path-tag">{tag} ↗</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────── -->
  <section class="section" id="about">
    <div class="about-grid">
      <div class="about-left">
        <p class="eyebrow blue"><span class="pulse"></span>About me</p>
        <h2>Akshit Pratiush</h2>
        <p class="about-role">{profile.role}</p>
        <a class="btn about-linkedin" href={profile.linkedIn} target="_blank" rel="noreferrer">
          LinkedIn ↗
        </a>
      </div>
      <div class="about-right">
        {profile.bio.map((para: string) => <p>{para}</p>)}
        <div class="about-tags">
          {profile.skills.map((tag: string) => (
            <span>{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Now ───────────────────────────────────────────── -->
  <div class="now-band">
    <p class="eyebrow label"><span class="pulse"></span>Now</p>
    <p class="now-copy">{profile.now}</p>
  </div>

</BaseLayout>

